  "claims": [
    {
      "claim_id": "T00-01",
      "claim": "序章算例采用400 K与300 K的理想两热源，其可逆效率上限为25%，100 J入热至多25 J净功、至少75 J排热。",
      "type": "modern_physics",
      "source_ids": [
        "R20"
      ],
      "locator": "OpenStax §4.5及本章代数计算",
      "verified": true
    },
    {
      "claim_id": "T00-02",
      "claim": "循环热机的工作物质一周期回原状态，能量守恒有W=Qh−Qc。",
      "type": "modern_physics",
      "source_ids": [
        "R20"
      ],
      "locator": "OpenStax §4.5",
      "verified": true
    },
    {
      "claim_id": "T00-03",
      "claim": "在相同两恒温热源间工作的可逆热机有最大效率，现实不可逆热机不超过它。",
      "type": "modern_physics",
      "source_ids": [
        "R20"
      ],
      "locator": "OpenStax §4.5 Carnot's Principle",
      "verified": true
    },
    {
      "claim_id": "T00-04",
      "claim": "1712年纽科门第一台早期蒸汽抽水机在达德利附近投入使用。",
      "type": "historical_fact",
      "source_ids": [
        "R19",
        "R21"
      ],
      "locator": "Science Museum馆藏说明与博物馆历史文章",
      "verified": true
    },
    {
      "claim_id": "T00-05",
      "claim": "纽科门式大气机依靠缸内冷凝形成部分真空和外界大气压力推动活塞。",
      "type": "historical_fact",
      "source_ids": [
        "R19"
      ],
      "locator": "Science Museum馆藏条目",
      "verified": true
    },
    {
      "claim_id": "T00-06",
      "claim": "瓦特1765年前后提出独立冷凝器，减少汽缸反复加热/冷却造成的燃料耗费。",
      "type": "historical_fact",
      "source_ids": [
        "R02"
      ],
      "locator": "Saslow 2020 §5",
      "verified": true
    },
    {
      "claim_id": "T00-07",
      "claim": "卡诺1824年出版《论火的动力》，提出热机最大机械效果及对工作物质的依赖问题。",
      "type": "historical_fact",
      "source_ids": [
        "R18",
        "R01"
      ],
      "locator": "Carnot 1824原著开头问题段；APS历史说明",
      "verified": true
    },
    {
      "claim_id": "T00-08",
      "claim": "卡诺原著以热质在冷热源之间转移解释做功，并借可逆循环论证理想最大效果。",
      "type": "historical_fact",
      "source_ids": [
        "R18",
        "R02"
      ],
      "locator": "Carnot 1824原著冷热源及可逆过程段；Saslow §6",
      "verified": true
    },
    {
      "claim_id": "T00-09",
      "claim": "卡诺的1824年理论不是现代能量守恒的完整框架；现代效率公式属于后来的热力学重述。",
      "type": "historical_interpretation",
      "source_ids": [
        "R18",
        "R02",
        "R20"
      ],
      "locator": "原著与Saslow历史研究、OpenStax对照",
      "verified": true
    },
    {
      "claim_id": "T00-10",
      "claim": "迈尔、焦耳及赫尔姆霍茨在1840年代推动热功等价与能量守恒认识。",
      "type": "historical_fact",
      "source_ids": [
        "R02"
      ],
      "locator": "Saslow 2020 §8—9",
      "verified": true
    },
    {
      "claim_id": "T00-11",
